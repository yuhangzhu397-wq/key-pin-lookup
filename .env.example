# Server
PORT=8080

# Use mock data for local UI preview only. Keep false in production.
MOCK_MODE=false

# Recommended: reuse JoyBuilder Ops query API.
DATA_SOURCE=joybuilder_ops
OPS_API_BASE=http://joybuilder-ops.jdcloud.com/api/v1
OPS_ACCESS_TOKEN=
OPS_DB_CONFIG_ID=
OPS_DB_CONFIG_NAME=国内
OPS_DATABASE=maas
OPS_TABLE=api_key

# Alternative: direct read-only MySQL account.
# Set DATA_SOURCE=mysql to use these fields.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=joymaas_lookup_readonly
DB_PASSWORD=
DB_NAME=maas
DB_TABLE=api_key
DB_SSL=false

# Optional: trust the first reverse proxy in an internal deployment.
TRUST_PROXY=false

# Production access control. The trusted SSO gateway must remove any incoming
# spoofed header and inject the authenticated operator account itself.
AUTH_MODE=proxy
AUTH_USER_HEADER=x-erp-user
AUTH_ALLOWED_USERS=
AUDIT_LOG=true
